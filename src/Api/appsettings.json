{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Messaging": {
    "Provider": "Log",
    "ConnectionString": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "DoceFlow",
    "Audience": "DoceFlow.Clients",
    "ExpirationMinutes": 60
  }
}
